# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 공유/커밋 금지)
DISCORD_TOKEN=여기에_봇_토큰
CHANNEL_ID=알림받을_채널_ID

# 감시할 티커 (쉼표 구분). 나스닥100 지수 자체는 ^NDX
TICKERS=QQQ
# σ 계산 기간 (거래일). 20 ≈ 1개월, 60 ≈ 3개월, 252 ≈ 1년
LOOKBACK_DAYS=252
# 누적 시그마를 볼 기간 (거래일, 쉼표 구분). 비우면 누적 알림 끔
CUMULATIVE_DAYS=3,5
# 몇 σ 이상부터 알림
SIGMA_THRESHOLD=1
# 확인 주기 (분)
CHECK_INTERVAL_MIN=5
# 알림 시 멘션할 역할 ID (선택, 비워두면 멘션 없음)
ALERT_ROLE_ID=
# true 면 미국 정규장(09:30~16:00 ET)에만 확인
MARKET_HOURS_ONLY=true
