# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 공유/커밋 금지)
DISCORD_TOKEN=여기에_봇_토큰
CHANNEL_ID=알림받을_채널_ID

# 감시할 티커 (쉼표 구분). 나스닥100 지수 자체는 ^NDX
TICKERS=QQQ
# σ 계산 기간 (거래일). 20 ≈ 1개월, 60 ≈ 3개월, 252 ≈ 1년
LOOKBACK_DAYS=252
# 화면에 보여줄 누적 시그마 기간 (거래일, 쉼표 구분)
CUMULATIVE_DAYS=3,5
# 그중 자동 알림까지 보낼 기간. 비우면 누적 알림 끔
ALERT_CUMULATIVE_DAYS=3
# 몇 σ 이상 하락부터 알림 (상승은 알리지 않음)
SIGMA_THRESHOLD=2
# 확인 주기 (분)
CHECK_INTERVAL_MIN=5
# 알림 시 멘션할 역할 ID (선택, 비워두면 멘션 없음)
ALERT_ROLE_ID=
# true 면 미국 거래 시간(프리장·정규장·애프터장·주간거래)에만 확인
MARKET_HOURS_ONLY=true
# 한국투자증권 Open API 키 (선택). 비우면 Yahoo로 정규장만 감시
KIS_APP_KEY=
KIS_APP_SECRET=
# 프리장·애프터장·주간거래까지 알릴 종목 (KIS 키 필요)
EXTENDED_TICKERS=QQQ
